#pragma once
#include <cstddef>

namespace {}
template <typename T, size_t N>
struct Array {
    static_assert(N > 0, "Array of size 0 is not supported in kernel core!");

    // 保持公开以支持聚合初始化：Array<int, 3> arr{1, 2, 3};
    T _data[N];

    // --- 迭代器类型定义 ---
    using value_type      = T;
    using size_type       = size_t;
    using difference_type = ptrdiff_t;
    using reference       = T&;
    using const_reference = const T&;
    using pointer         = T*;
    using const_pointer   = const T*;
    using iterator        = T*;
    using const_iterator  = const T*;

    // --- 迭代器支持 (直接走指针运算，彻底规避 &_data[N] 的 UB 嫌疑) ---
    [[nodiscard]] constexpr iterator begin() noexcept { return _data; }
    [[nodiscard]] constexpr const_iterator begin() const noexcept { return _data; }
    [[nodiscard]] constexpr iterator end() noexcept { return _data + N; }
    [[nodiscard]] constexpr const_iterator end() const noexcept { return _data + N; }

    [[nodiscard]] constexpr const_iterator cbegin() const noexcept { return _data; }
    [[nodiscard]] constexpr const_iterator cend() const noexcept { return _data + N; }

    // --- 元素访问 ---
    [[nodiscard]] constexpr reference operator[](size_type index) noexcept {
        return _data[index];
    }

    [[nodiscard]] constexpr const_reference operator[](size_type index) const noexcept {
        return _data[index];
    }

    [[nodiscard]] constexpr reference front() noexcept { return _data[0]; }
    [[nodiscard]] constexpr const_reference front() const noexcept { return _data[0]; }

    [[nodiscard]] constexpr reference back() noexcept { return _data[N - 1]; }
    [[nodiscard]] constexpr const_reference back() const noexcept { return _data[N - 1]; }

    [[nodiscard]] constexpr pointer data() noexcept { return _data; }
    [[nodiscard]] constexpr const_pointer data() const noexcept { return _data; }

    // --- 容量查询 ---
    [[nodiscard]] static constexpr size_type size() noexcept { return N; }
    [[nodiscard]] static constexpr size_type max_size() noexcept { return N; }
    [[nodiscard]] static constexpr bool empty() noexcept { return false; }

    // --- 全量填充 (支持编译期 constexpr 展开) ---
    constexpr void fill(const T& value) {
        for (size_type i = 0; i < N; ++i) {
            _data[i] = value;
        }
    }
};