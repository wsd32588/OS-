#pragma once
#include <cstddef>
#include <stdint.h>

#ifndef KERNEL_ASSERT
extern "C" [[noreturn]] void kernel_panic(const char* file, int line, const char* msg);
#define KERNEL_ASSERT(cond, msg) \
    do { \
        if (!(cond)) { \
            kernel_panic(__FILE__, __LINE__, msg); \
        } \
    } while (0)
#endif

namespace std {

template <typename T>
class span {
public:
    constexpr span() noexcept : data_(nullptr), size_(0) {}

    constexpr span(T* ptr, size_t count) noexcept : data_(ptr), size_(count) {
        KERNEL_ASSERT(
            ptr != nullptr || count == 0,
            "span: null data with nonzero size");
        KERNEL_ASSERT(
            count <= SIZE_MAX / sizeof(T),
            "span: size overflow");
    }

    template <size_t N>
    constexpr span(T (&arr)[N]) noexcept : data_(arr), size_(N) {}

    [[nodiscard]] constexpr T* data() const noexcept { return data_; }
    [[nodiscard]] constexpr size_t size() const noexcept { return size_; }
    [[nodiscard]] constexpr size_t size_bytes() const noexcept { return size_ * sizeof(T); }
    [[nodiscard]] constexpr bool empty() const noexcept { return size_ == 0; }

    constexpr T& operator[](size_t idx) const noexcept {
        KERNEL_ASSERT(idx < size_, "span: index out of range");
        return data_[idx];
    }

    constexpr T* begin() const noexcept { return data_; }
    constexpr T* end() const noexcept { return data_ + size_; }

    constexpr span<T> subspan(size_t offset, size_t count) const noexcept {
        KERNEL_ASSERT(
            offset <= size_ && count <= size_ - offset,
            "span: subspan out of range");

        T* start = data_;
        if (offset != 0) {
            start += offset;
        }
        return span<T>(start, count);
    }

    constexpr span<T> subspan(size_t offset) const noexcept {
        KERNEL_ASSERT(offset <= size_, "span: subspan offset out of range");
        return subspan(offset, size_ - offset);
    }

    [[nodiscard]] constexpr span<T> first(size_t count) const noexcept {
        KERNEL_ASSERT(count <= size_, "span: first out of range");
        return subspan(0, count);
    }

    [[nodiscard]] constexpr span<T> last(size_t count) const noexcept {
        KERNEL_ASSERT(count <= size_, "span: last out of range");
        return subspan(size_ - count, count);
    }

private:
    T* data_;
    size_t size_;
};

template <typename T>
span<const byte> as_bytes(span<T> value) noexcept {
    return span<const byte>(
        reinterpret_cast<const byte*>(value.data()),
        value.size_bytes());
}

template <typename T>
span<byte> as_writable_bytes(span<T> value) noexcept {
    return span<byte>(
        reinterpret_cast<byte*>(value.data()),
        value.size_bytes());
}

} // namespace std
