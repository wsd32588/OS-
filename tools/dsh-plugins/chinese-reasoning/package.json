{
  "name": "@local/dsh-chinese-reasoning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Global system-prompt section that makes every agent write its internal reasoning in Simplified Chinese.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
